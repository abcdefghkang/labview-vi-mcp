<VI _name="Clamp Demo Swapped.vi" description="Two-VI program\3A a While loop accumulates Increment onto Start Value each iteration\2C passes the candidate through the Clamp Value.vi subVI to hold it inside [Lower Bound\2C Upper Bound]\2C counts iterations\2C flags whether any value ever left the range\2C and collects the per-iteration clamped history as an array. The loop stops once the iteration count reaches Max Iterations.">
  <FreeLabel comment="Clamp demo\3A loop calling a subVI" uid="1000" uid_parent="root"/>
  <Control _name="Start Value" description="Initial value of the accumulator before the first iteration." outputs="value:100.value" type="double" uid="100" uid_parent="root" value="0"/>
  <Control _name="Increment" description="Amount added to the accumulator on every iteration." outputs="value:101.value" type="double" uid="101" uid_parent="root" value="1.5"/>
  <Control _name="Lower Bound" description="Lower clamp bound passed to the subVI." outputs="value:102.value" type="double" uid="102" uid_parent="root" value="0"/>
  <Control _name="Upper Bound" description="Upper clamp bound passed to the subVI." outputs="value:103.value" type="double" uid="103" uid_parent="root" value="10"/>
  <Control _name="Max Iterations" description="Loop stops once this many iterations have run." outputs="value:104.value" type="int32" uid="104" uid_parent="root" value="8"/>
  <Constant _name="Zero" outputs="value:220.value" type="int32" uid="220" uid_parent="root" value="0"/>
  <Constant _name="False" outputs="value:221.value" type="bool" uid="221" uid_parent="root" value="false"/>
  <Structure _name="While Loop" count="" uid="200" uid_parent="root">
    <Tunnel _id="In1" inputs="value:101.value" outputs="value:211.value" uid="211" uid_parent="200"/>
    <Tunnel _id="In2" inputs="value:102.value" outputs="value:212.value" uid="212" uid_parent="200"/>
    <Tunnel _id="In3" inputs="value:103.value" outputs="value:213.value" uid="213" uid_parent="200"/>
    <Tunnel _id="In4" inputs="value:104.value" outputs="value:214.value" uid="214" uid_parent="200"/>
    <Constant _name="One" outputs="value:224.value" type="int32" uid="224" uid_parent="200" value="1"/>
    <Node _name="Add" inputs="x:250.x,y:211.value" outputs="x+y:250.x+y" uid="250" uid_parent="200"/>
    <Node _name="Add" inputs="x:253.x,y:224.value" outputs="x+y:253.x+y" uid="253" uid_parent="200"/>
    <Node _name="Greater?" inputs="x:250.x+y,y:213.value" outputs="x > y?:252.x > y?" uid="252" uid_parent="200"/>
    <Node _name="Less?" inputs="x:250.x+y,y:212.value" outputs="x &lt; y?:255.x &lt; y?" uid="255" uid_parent="200"/>
    <Call inputs="x:250.x+y,lo:212.value,hi:213.value" outputs="clamped:260.clamped" target="Clamp Value.vi" uid="260" uid_parent="200"/>
    <Node _name="Greater Or Equal?" inputs="x:253.x+y,y:214.value" outputs="x >= y?:254.x >= y?" uid="254" uid_parent="200"/>
    <Node _name="Or" inputs="x:252.x > y?,y:255.x &lt; y?" outputs="x .or. y?:256.x .or. y?" uid="256" uid_parent="200"/>
    <Node _name="Or" inputs="x:256.x .or. y?,y:257.y" outputs="x .or. y?:257.x .or. y?" uid="257" uid_parent="200"/>
    <Condition inputs="value:254.x >= y?" uid="201" uid_parent="200" value="stop"/>
    <ShiftReg uid="230" uid_parent="200">
      <Left inputs="value:100.value" outputs="value:250.x" uid="231" uid_parent="230"/>
      <Right inputs="value:260.clamped" outputs="value:232.value" uid="232" uid_parent="230"/>
    </ShiftReg>
    <ShiftReg uid="233" uid_parent="200">
      <Left inputs="value:220.value" outputs="value:253.x" uid="234" uid_parent="233"/>
      <Right inputs="value:253.x+y" outputs="value:235.value" uid="235" uid_parent="233"/>
    </ShiftReg>
    <ShiftReg uid="236" uid_parent="200">
      <Left inputs="value:221.value" outputs="value:257.y" uid="237" uid_parent="236"/>
      <Right inputs="value:257.x .or. y?" outputs="value:238.value" uid="238" uid_parent="236"/>
    </ShiftReg>
    <Tunnel _id="Out1" inputs="value:260.clamped" mode="index" outputs="value:270.value" uid="270" uid_parent="200"/>
  </Structure>
  <Indicator _name="Final Value" description="Accumulator value after the last iteration." inputs="value:232.value" type="double" uid="300" uid_parent="root" value="0"/>
  <Indicator _name="Iterations" description="Number of iterations that ran." inputs="value:235.value" type="int32" uid="301" uid_parent="root" value="0"/>
  <Indicator _name="Saturated" description="TRUE once any candidate fell outside the bounds." inputs="value:238.value" type="bool" uid="302" uid_parent="root" value="false"/>
  <Indicator _name="History" description="Clamped accumulator value after each iteration." inputs="value:270.value" type="array{double}" uid="303" uid_parent="root" value="[]"/>
</VI>