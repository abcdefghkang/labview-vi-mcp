        <Tunnel _id="Out2" inputs="value:4267.value" uid="4268" uid_parent="4260"/>
      </CaseFrame>

      <CaseFrame selector=" &lt;Count&gt;\3A User Event " uid="4270" uid_parent="4250">
        <FreeLabel comment="Store the Count payload into the shift register." uid="4279" uid_parent="4270"/>
        <Tunnel _id="In1" outputs="value:" uid="4271" uid_parent="4270"/>
        <Tunnel _id="In2" outputs="value:" uid="4272" uid_parent="4270"/>
        <Tunnel _id="In3" outputs="value:4273.value" uid="4273" uid_parent="4270"/>
        <Tunnel _id="In4" outputs="value:" uid="4274" uid_parent="4270"/>
        <Node _name="Event Data Node" fields="Source,Count,Time" outputs="Source:,Count:4275.count,Time:" uid="4275" uid_parent="4270"/>
        <Tunnel _id="Out1" inputs="value:4275.count" uid="4276" uid_parent="4270"/>
        <Constant outputs="value:4277.value" type="bool" uid="4277" uid_parent="4270" value="false"/>
        <Tunnel _id="Out2" inputs="value:4277.value" uid="4278" uid_parent="4270"/>
      </CaseFrame>

      <Tunnel _id="Out1" outputs="value:4280.value" uid="4280" uid_parent="4250"/>
      <Tunnel _id="Out2" outputs="value:4281.value" uid="4281" uid_parent="4250"/>
    </Structure>

    <Condition inputs="value:4281.value" uid="4282" uid_parent="4230" value="stop"/>
    <Tunnel _id="Out1" inputs="value:4251.value" outputs="value:4283.value" uid="4283" uid_parent="4230"/>
  </Structure>

  <Node _name="Unregister For Events" inputs="event registration refnum:4283.value,error in:4212.error out" outputs="error out:4290.error out" uid="4290" uid_parent="root"/>

  <Node _name="Destroy User Event" inputs="user event:4210.user event,error in:4290.error out" outputs="error out:4291.error out" uid="4291" uid_parent="root"/>
  <Node _name="Destroy User Event" inputs="user event:4211.user event,error in:4291.error out" outputs="error out:4292.error out" uid="4292" uid_parent="root"/>

  <Indicator _name="Last Count" connection="recommended" inputs="value:4242.final_count" type="int32" uid="4300" uid_parent="root" value="0" description="The Count payload of the last Count event handled."/>

  <Indicator _name="Error Out" connection="recommended" inputs="value:4292.error out" type="cluster{bool.status,int32.code,string.source}" uid="4301" uid_parent="root" value="[false,0,]" description="The error chain of the whole event lifetime, from Create through Destroy."/>

