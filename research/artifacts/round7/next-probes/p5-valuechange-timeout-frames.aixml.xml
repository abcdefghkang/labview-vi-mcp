<VI _name="Static Events And Timeout.vi" description="Round8 probe P5 (UNVERIFIED - prepared 2026-10-22, run when LabVIEW is up): the STATIC-event shape of upstream suite test t88 - a While Loop + Event Structure with two panel Value Change frames (&quot;Go&quot; and latched &quot;Stop&quot;) plus a Timeout frame fed 500 ms through a structure tunnel. No user event, no registration: the interactive-HMI minimal piece. Go Presses and Timeouts are shift registers (Round4/6 idiom: frames read the SR nets directly, every frame assigns every Out tunnel); Stop writes the loop's stop tunnel. Expected on a run that sets Go=true then Stop=true: execState 1, Go Presses &gt;= 1, Timeouts &gt;= 0, Error-free. THE TIMEOUT TUNNEL WIRING IS THE LEAST-CERTAIN PART of this document - if the composer refuses or the VI is broken, inspect how the eventTimeOut terminal is fed before rewriting the frames.">
  <FreeLabel comment="Static events and a timeout frame, no user event." uid="4200" uid_parent="root"/>

  <Control _name="Go" outputs="value:4201.value" type="bool" uid="4201" uid_parent="root" value="false" description="Each Value Change of this button counts one Go Press."/>
  <Control _name="Stop" outputs="value:4202.value" style="latched" type="bool" uid="4202" uid_parent="root" value="false" description="Latched; its Value Change stops the handler loop."/>

  <Constant _name="Timeout ms" outputs="value:4203.ms" type="int32" uid="4203" uid_parent="root" value="500" description="Timeout period handed to the Event Structure through a tunnel."/>
  <Constant _name="Zero" outputs="value:4204.zero" type="int32" uid="4204" uid_parent="root" value="0"/>
  <Constant _name="One" outputs="value:4205.one" type="int32" uid="4205" uid_parent="root" value="1"/>
  <Constant _name="False" outputs="value:4206.f" type="bool" uid="4206" uid_parent="root" value="false"/>

  <Structure _name="While Loop" count="4310.value" label="Event handler" uid="4310" uid_parent="root">

    <ShiftReg uid="4330" uid_parent="4310">
      <Left inputs="value:4204.zero" outputs="value:4331.gopresses" uid="4331" uid_parent="4330"/>
      <Right inputs="value:4360.value" outputs="value:4332.final_go" uid="4332" uid_parent="4330"/>
    </ShiftReg>
    <ShiftReg uid="4340" uid_parent="4310">
      <Left inputs="value:4204.zero" outputs="value:4341.timeouts" uid="4341" uid_parent="4340"/>
      <Right inputs="value:4361.value" outputs="value:4342.final_to" uid="4342" uid_parent="4340"/>
    </ShiftReg>

    <Structure _name="Event Structure" uid="4320" uid_parent="4310">
      <Tunnel _id="In1" inputs="value:4203.ms" outputs="value:4321.ms" uid="4321" uid_parent="4320"/>
      <Tunnel _id="In2" inputs="value:4331.gopresses" uid="4322" uid_parent="4320"/>
      <Tunnel _id="In3" inputs="value:4341.timeouts" uid="4323" uid_parent="4320"/>
      <Tunnel _id="In4" inputs="value:4310.value" uid="4324" uid_parent="4320"/>

      <CaseFrame selector=" &quot;Go&quot;\3A Value Change " uid="4350" uid_parent="4320">
        <FreeLabel comment="Count one Go press." uid="4359" uid_parent="4350"/>
        <Tunnel _id="In1" outputs="value:" uid="4351" uid_parent="4350"/>
        <Tunnel _id="In2" outputs="value:4352.value" uid="4352" uid_parent="4350"/>
        <Tunnel _id="In3" outputs="value:4353.value" uid="4353" uid_parent="4350"/>
        <Tunnel _id="In4" outputs="value:" uid="4354" uid_parent="4350"/>
        <Control _name="Go" outputs="value:4355.value" type="bool" uid="4355" uid_parent="4350" value="false"/>
        <Node _name="Event Data Node" fields="Source,Type,Time" outputs="Source:,Type:,Time:" uid="4356" uid_parent="4350"/>
        <Node _name="Add" inputs="x:4352.value,y:4205.one" outputs="x+y:4357.gopresses1" uid="4357" uid_parent="4350"/>
        <Tunnel _id="Out1" inputs="value:4357.gopresses1" uid="4358" uid_parent="4350"/>
        <Tunnel _id="Out2" inputs="value:4353.value" uid="4362" uid_parent="4350"/>
        <Tunnel _id="Out3" inputs="value:4206.f" uid="4363" uid_parent="4350"/>
      </CaseFrame>

      <CaseFrame selector=" Timeout " uid="4370" uid_parent="4320">
        <FreeLabel comment="Count one timeout tick." uid="4379" uid_parent="4370"/>
        <Tunnel _id="In1" outputs="value:4371.value" uid="4371" uid_parent="4370"/>
        <Tunnel _id="In2" outputs="value:4372.value" uid="4372" uid_parent="4370"/>
        <Tunnel _id="In3" outputs="value:4373.value" uid="4373" uid_parent="4370"/>
        <Tunnel _id="In4" outputs="value:" uid="4374" uid_parent="4370"/>
        <Node _name="Event Data Node" fields="Source,Type,Time" outputs="Source:,Type:,Time:" uid="4375" uid_parent="4370"/>
        <Node _name="Add" inputs="x:4373.value,y:4205.one" outputs="x+y:4376.timeouts1" uid="4376" uid_parent="4370"/>
        <Tunnel _id="Out1" inputs="value:4372.value" uid="4377" uid_parent="4370"/>
        <Tunnel _id="Out2" inputs="value:4376.timeouts1" uid="4378" uid_parent="4370"/>
        <Tunnel _id="Out3" inputs="value:4206.f" uid="4380" uid_parent="4370"/>
      </CaseFrame>

      <CaseFrame selector=" &quot;Stop&quot;\3A Value Change " uid="4390" uid_parent="4320">
        <FreeLabel comment="Latched Stop ends the loop." uid="4399" uid_parent="4390"/>
        <Tunnel _id="In1" outputs="value:" uid="4391" uid_parent="4390"/>
        <Tunnel _id="In2" outputs="value:4392.value" uid="4392" uid_parent="4390"/>
        <Tunnel _id="In3" outputs="value:4393.value" uid="4393" uid_parent="4390"/>
        <Tunnel _id="In4" outputs="value:" uid="4394" uid_parent="4390"/>
        <Control _name="Stop" outputs="value:" style="latched" type="bool" uid="4395" uid_parent="4390" value="false"/>
        <Node _name="Event Data Node" fields="Source,Type,Time" outputs="Source:,Type:,Time:" uid="4396" uid_parent="4390"/>
        <Tunnel _id="Out1" inputs="value:4392.value" uid="4397" uid_parent="4390"/>
        <Tunnel _id="Out2" inputs="value:4393.value" uid="4398" uid_parent="4390"/>
        <Constant outputs="value:4401.value" type="bool" uid="4401" uid_parent="4390" value="true"/>
        <Tunnel _id="Out3" inputs="value:4401.value" uid="4402" uid_parent="4390"/>
      </CaseFrame>

      <Tunnel _id="Out1" outputs="value:4360.value" uid="4360" uid_parent="4320"/>
      <Tunnel _id="Out2" outputs="value:4361.value" uid="4361" uid_parent="4320"/>
      <Tunnel _id="Out3" outputs="value:4364.value" uid="4364" uid_parent="4320"/>
    </Structure>

    <Condition inputs="value:4364.value" uid="4365" uid_parent="4310" value="stop"/>
  </Structure>

  <Indicator _name="Go Presses" connection="recommended" inputs="value:4332.final_go" type="int32" uid="4500" uid_parent="root" value="0" description="Go Value Change events handled before the loop stopped."/>
  <Indicator _name="Timeouts" connection="recommended" inputs="value:4342.final_to" type="int32" uid="4501" uid_parent="root" value="0" description="Timeout frames handled before the loop stopped."/>

</VI>
