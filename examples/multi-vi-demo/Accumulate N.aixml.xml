  <Constant _name="Zero" outputs="value:4202.zero" type="int32" uid="4202" uid_parent="root" value="0"/>
  <Constant _name="One" outputs="value:4203.one" type="int32" uid="4203" uid_parent="root" value="1"/>
  <Structure _name="While Loop" count="" uid="4200" uid_parent="root">
